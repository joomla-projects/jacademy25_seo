<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin"
           group="system"
           method="upgrade"
           version="6.0">
    <name>PLG_SYSTEM_OPENGRAPH</name>
    <author>Joomla! Project</author>
    <creationDate>2025-06</creationDate>
    <copyright>(C) 2025 Open Source Matters, Inc.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>support@joomla.org</authorEmail>
    <authorUrl>https://joomla.org</authorUrl>
    <version>__DEPLOY_VERSION__</version>
    <description>PLG_SYSTEM_OPENGRAPH_DESCRIPTION</description>
    <namespace path="src">Joomla\Plugin\System\Opengraph</namespace>
    <media destination="plg_system_opengraph"
           folder="media">
        <folder>js</folder>
        <filename>joomla.asset.json</filename>
    </media>
    <files>
        <folder plugin="opengraph">src</folder>
        <folder>services</folder>
        <filename>opengraph.xml</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/plg_system_opengraph.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_opengraph.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="enable_og_generation"
                       type="radio"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="PLG_SYSTEM_OPENGRAPH_ENABLE_OG_GENERATION"
                       description="PLG_SYSTEM_OPENGRAPH_ENABLE_OG_GENERATION_DESC">
                    <option value="0">JDISABLED</option>
                    <option value="1">JENABLED</option>
                </field>
                <field name="fb_app_id"
                       type="text"
                       label="PLG_SYSTEM_OPENGRAPH_FB_APP_ID_LABEL"
                       description="PLG_SYSTEM_OPENGRAPH_FB_APP_ID_DESC" />
                <field name="max_title_length"
                       type="number"
                       default="60"
                       label="PLG_SYSTEM_OPENGRAPH_MAX_TITLE_LABEL"
                       description="PLG_SYSTEM_OPENGRAPH_MAX_TITLE_DESC"
                       min="10"
                       max="100" />
                <field name="max_description_length"
                       type="number"
                       default="160"
                       label="PLG_SYSTEM_OPENGRAPH_MAX_DESC_LABEL"
                       description="PLG_SYSTEM_OPENGRAPH_MAX_DESC_DESC"
                       min="50"
                       max="300" />
                <field name="max_alt_length"
                       type="number"
                       default="125"
                       label="PLG_SYSTEM_OPENGRAPH_MAX_ALT_LABEL"
                       description="PLG_SYSTEM_OPENGRAPH_MAX_ALT_DESC"
                       min="50"
                       max="200" />
            </fieldset>
        </fields>
    </config>
</extension>